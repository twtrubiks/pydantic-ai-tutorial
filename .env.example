# 複製此檔案為 .env 後填入你自己的金鑰：cp .env.example .env
# 各範例只需要其對應的金鑰，不必全部填寫。

# Anthropic (Claude) - claude_cache_demo.py、claude_harness_demo.py、tool_approval_demo.py、web_chat_demo.py、tools_demo_claude.py、error_handling_demo.py
# 取得位置：https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Google AI Studio (Gemini) - tools_demo.py、gemini_thinking_demo.py、gemini_embedding_demo.py 等
# 取得位置：https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key

# OpenRouter - tools_demo_openrouter.py
# 取得位置：https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# NVIDIA NIM - output_validator_demo.py、mcp_client_demo.py、streaming_demo.py、toolset_filter_demo.py、output_mode_demo.py、
#              bank_support_agent_demo.py、message_history_demo.py、evals_demo.py
# 取得位置：https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-...

# Odoo MCP server 端點 - mcp_client_demo.py（選填，預設 http://localhost:8000/mcp）
# MCP server 來源：https://github.com/twtrubiks/odoo19-mcp-server
ODOO_MCP_URL=http://localhost:8000/mcp
